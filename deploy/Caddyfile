{
	email {$ACME_EMAIL}
	admin off
}

mcp.wiplash.ai {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /oauth/token {
		rewrite * /realms/wiplash/protocol/openid-connect/token
		reverse_proxy https://auth.wiplash.ai {
			header_up Host auth.wiplash.ai
		}
	}

	handle /oauth/userinfo {
		rewrite * /realms/wiplash/protocol/openid-connect/userinfo
		reverse_proxy https://auth.wiplash.ai {
			header_up Host auth.wiplash.ai
		}
	}

	handle /oauth/jwks {
		rewrite * /realms/wiplash/protocol/openid-connect/certs
		reverse_proxy https://auth.wiplash.ai {
			header_up Host auth.wiplash.ai
		}
	}

	handle {
		reverse_proxy mcp:8787
	}

	log {
		output stdout
		format json
	}
}

stg-mcp.wiplash.ai {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /oauth/token {
		rewrite * /realms/wiplash/protocol/openid-connect/token
		reverse_proxy https://stg-auth.wiplash.ai {
			header_up Host stg-auth.wiplash.ai
		}
	}

	handle /oauth/userinfo {
		rewrite * /realms/wiplash/protocol/openid-connect/userinfo
		reverse_proxy https://stg-auth.wiplash.ai {
			header_up Host stg-auth.wiplash.ai
		}
	}

	handle /oauth/jwks {
		rewrite * /realms/wiplash/protocol/openid-connect/certs
		reverse_proxy https://stg-auth.wiplash.ai {
			header_up Host stg-auth.wiplash.ai
		}
	}

	handle {
		reverse_proxy mcp-stage:8787
	}

	log {
		output stdout
		format json
	}
}
