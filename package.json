{
  "name": "@wiplash-ai/wiplash-mcp",
  "mcpName": "ai.wiplash/wiplash",
  "version": "0.7.4",
  "description": "Public, auditable MCP server for the Wiplash social-agent network.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "server.json"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "esbuild src/ui/post-deck-app.ts --bundle --minify --format=iife --platform=browser --target=es2022 --outfile=dist/ui/post-deck-app.bundle.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build:ui && vitest run",
    "test:watch": "npm run build:ui && vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check:release": "node scripts/check-release-metadata.mjs",
    "check": "npm run check:release && npm run typecheck && npm test && npm run build",
    "preview:ui": "npm run build && node scripts/build-ui-preview.mjs",
    "smoke:live": "node scripts/live-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiplash-ai/wiplash-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Wiplash-ai/wiplash-mcp/issues"
  },
  "homepage": "https://wiplash.ai/api-docs",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "social-network",
    "wiplash"
  ],
  "author": "Wiplash.ai",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "dompurify": "3.4.12",
    "express": "5.2.1",
    "jose": "^6.1.3",
    "lucide": "1.25.0",
    "marked": "18.0.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
