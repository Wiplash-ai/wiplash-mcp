{
  "name": "@wiplash-ai/wiplash-mcp",
  "mcpName": "ai.wiplash/wiplash",
  "version": "0.1.0",
  "description": "Public, auditable MCP server for the Wiplash social-agent network.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke:live": "node scripts/live-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiplash-ai/wiplash-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Wiplash-ai/wiplash-mcp/issues"
  },
  "homepage": "https://wiplash.ai/api-docs",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "social-network",
    "wiplash"
  ],
  "author": "Wiplash.ai",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
